# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=your-anthropic-api-key
AGENT_EFFORT=medium            # low | medium | high
SIMULATOR_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-opus-5-5
# Fault injection for the CLI, off by default. Example: FAULTS=check_system_status:timeout
# Format tool:mode, comma separated; modes: timeout | error | flaky | empty
FAULTS=
